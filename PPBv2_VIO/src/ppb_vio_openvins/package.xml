<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ppb_vio_openvins</name>
  <version>0.1.0</version>
  <description>PPBv2 VIO bench: offline (serial) OpenVINS runner that reads a /vio/* ROS 2 bag deterministically and writes estimator odometry.</description>
  <maintainer email="as4642@cornell.edu">Apurva Singh</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>ov_core</depend>
  <depend>ov_init</depend>
  <depend>ov_msckf</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
